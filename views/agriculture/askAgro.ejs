<% layout("./layouts/boilerplate") %>

<body>
    <div class="row-1 askAgro">
       <div class="col-6 offset-3 glass">
        <h2 class="offset-3">Reach Out Your Agrochemist</h2>
        <form class="form bg-dark p-2 text-light bg-opacity-25" method="post" action="/askAgro" enctype="multipart/form-data" >
            <div class="form-group ps-4 pe-4">
                <label for="farmerName">Your Name</label>
                 <input type="text" readonly name="farmerName" id="farmerName" class="form-control bg-light p-2 text-dark bg-opacity-50" placeholder="Name of the Farmer" value="<%= username %>">
            </div>
            
            <div class="form-group ps-4 pe-4">
                <label for="cropType">Enter Name of Your Crop</label>
                <input type="text" class="form-control bg-light p-2 text-dark bg-opacity-50" name="cropType" id="cropType" placeholder="Enter Crop Type">
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="filePath">Upload image/video</label>
                <input type="file" class="form-control bg-light p-2 text-dark bg-opacity-50" name="filePath[]" id="filePath" multiple>    
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="diseaseDescription">Enter Description of The Disease</label>
            <textarea id="diseaseDescription" class="form-control bg-light p-2 text-dark bg-opacity-50" name="diseaseDescription" rows="4" cols="50" placeholder="Provide Description About The Disease Which Your Crop Is affected By"></textarea>
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="state">Enter District And State From Where You Are Contacting</label>
                <input type="text" name="state" class="form-control bg-light p-2 text-dark bg-opacity-50" id="stete" placeholder="Kadapa AndhraPradesh">
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="address">Enter Address</label>
                <input type="text" name="address" class="form-control bg-light p-2 text-dark bg-opacity-50" id="address" placeholder="Provide Your Address">
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="phoneNumber">Enter Your Phone Number</label>
            <input type="text" name="phoneNumber" class="form-control bg-light p-2 text-dark bg-opacity-50" id="phoneNumber" placeholder="Mobile Number">
            </div>

            <div class="form-group ps-4 pe-4">
                <label for="email">Enter Your e-Mail</label>
            <input type="email" name="email" class="form-control bg-light p-2 text-dark bg-opacity-50" id="email" placeholder="abc@gmail.com">
            </div>
            <br>
            
            <button class="btn btn-success  ms-4 mb-2 bg-success p-2 text-dark bg-opacity-100">submit</button>
        </form>
       </div>
    </div>
</body>
