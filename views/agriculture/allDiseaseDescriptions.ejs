<% layout("./layouts/boilerplate") %>

<style>
    .margin-right{
    margin-right: 15px !important;
}
</style>

<link rel="stylesheet" href="/css/afterSignUpOrLogin.css">

<div class="d-flex align-items-center mt-1">
    <h3>Hey <b class="text-warning"><%=name%>!</b> Welcome  to IntegratedCare</h3>
    <form action="/new/update/AgroChemist/<%= name %>" method="get" class="ms-auto">
        <button type="submit" class="changePassword me-3">
          <svg
            height="24"
            width="24"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M5 13c0-5.088 2.903-9.436 7-11.182C16.097 3.564 19 7.912 19 13c0 .823-.076 1.626-.22 2.403l1.94 1.832a.5.5 0 0 1 .095.603l-2.495 4.575a.5.5 0 0 1-.793.114l-2.234-2.234a1 1 0 0 0-.707-.293H9.414a1 1 0 0 0-.707.293l-2.234 2.234a.5.5 0 0 1-.793-.114l-2.495-4.575a.5.5 0 0 1 .095-.603l1.94-1.832C5.077 14.626 5 13.823 5 13zm1.476 6.696l.817-.817A3 3 0 0 1 9.414 18h5.172a3 3 0 0 1 2.121.879l.817.817.982-1.8-1.1-1.04a2 2 0 0 1-.593-1.82c.124-.664.187-1.345.187-2.036 0-3.87-1.995-7.3-5-8.96C8.995 5.7 7 9.13 7 13c0 .691.063 1.372.187 2.037a2 2 0 0 1-.593 1.82l-1.1 1.039.982 1.8zM12 13a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"
              fill="currentColor"
            ></path>
          </svg>
          <span>Change Password</span>
        </button>

        <!-- <button type="submit" class="margin-right">Logout!</button> -->
  </form>

  <form action="/logoutFarmer" method="get" >
    <button type="submit" class="logout me-3">
      <svg
        height="24"
        width="24"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M0 0h24v24H0z" fill="none"></path>
        <path
          d="M5 13c0-5.088 2.903-9.436 7-11.182C16.097 3.564 19 7.912 19 13c0 .823-.076 1.626-.22 2.403l1.94 1.832a.5.5 0 0 1 .095.603l-2.495 4.575a.5.5 0 0 1-.793.114l-2.234-2.234a1 1 0 0 0-.707-.293H9.414a1 1 0 0 0-.707.293l-2.234 2.234a.5.5 0 0 1-.793-.114l-2.495-4.575a.5.5 0 0 1 .095-.603l1.94-1.832C5.077 14.626 5 13.823 5 13zm1.476 6.696l.817-.817A3 3 0 0 1 9.414 18h5.172a3 3 0 0 1 2.121.879l.817.817.982-1.8-1.1-1.04a2 2 0 0 1-.593-1.82c.124-.664.187-1.345.187-2.036 0-3.87-1.995-7.3-5-8.96C8.995 5.7 7 9.13 7 13c0 .691.063 1.372.187 2.037a2 2 0 0 1-.593 1.82l-1.1 1.039.982 1.8zM12 13a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"
          fill="currentColor"
        ></path>
      </svg>
      <span>Logout!</span>
    </button>

    <!-- <button type="submit" class="margin-right">Logout!</button> -->
</form>

</div>

<% if(key==1) {%>
    <div class="card border-dark mb-3 mt-3">
        <div class="card-body text-light bg-dark">
            <h3>No Problems To Be Solved For Now!</h3>
        </div>
    </div>
<% }else{ %>
    <br>
    <h3 class="text-danger">Problems Sent By Farmers:</h3>
<br>
    <%for(let item of data)  {%>
        <% for(let i=0;i<item.diseaseInfo.length;i++) {%>
            <% if(item.diseaseInfo[i].isProblemSolved == "No") {%>
                <div class="card border-dark mb-3">
                    <div class="card-body text-light bg-dark">
                        <span>Name of The Farmer: <b><%= item.farmerName %></b></span>
                        <br>
                        <span>Type of Crop: <b><%= item.diseaseInfo[i].cropType %></b></span>
                        <br>
                        <span>Disease Description: <b><%= item.diseaseInfo[i].diseaseDescription %></b></span>
                        <br><br>
                        <div class="d-flex justify-content-end">
                            <form method="get" action="/new/<%= item.diseaseInfo[i]._id %>/solutionForm">
                                <button class="btn margin-right button">Send Solution</button>
                            </form>
                            <form method="get" action="/<%= item._id %>/detailedView/<%= item.diseaseInfo[i]._id %>">
                                <button class="btn  button1">Deatailed View</button>
                            </form>
                        </div>
                    </div>
                </div>
            <%}  %>
        <% } %>
    <%}  %>
    
<%  }%>

