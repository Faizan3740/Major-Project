<% layout("./layouts/boilerplate") %>

<style>
    .margin-top{
        margin-top: -60px;
    }
</style>

<body>
    <div class="row-1 d-flex align-items-center vh-100 rancher">
       <div class="col-6 offset-3 margin-top">
        <h2 class="offset-3">Change Your Password</h2>
        <form method="post" class="bg-dark p-2 text-light bg-opacity-25" action="/updatePasswordUser1">
            <div class="form-group ps-4 pe-4 pd-4">
                <label for="username">Set Your UserName</label>
                 <input type="text" name="username" id="password" readonly value="<%= data[0].username %>" class="form-control bg-light p-2 text-dark bg-opacity-50" placeholder="UserName">
            </div>
            <br>

            <div class="form-group ps-4 pe-4">
                <label for="email">Enter Your e-Mail</label>
                 <input type="email" name="email" id="email" readonly value="<%= data[0].email %>" class="form-control bg-light p-2 text-dark bg-opacity-50" placeholder="e-Mail">
            </div>
            <br>
            <div class="form-group ps-4 pe-4 pd-4">
                <label for="oldPassword">Enter Your Old Password</label>
                 <input type="password" name="oldPassword" id="oldPassword" class="form-control bg-light p-2 text-dark bg-opacity-50" placeholder="Password">
            </div>
            <br>
            <div class="form-group ps-4 pe-4 pd-4">
                <label for="newPassword">Set Your New Password</label>
                 <input type="password" name="newPassword" id="newPassword" class="form-control bg-light p-2 text-dark bg-opacity-50" placeholder="Password">
            </div>
            <br>
            <button class="btn btn-success  ms-4 mb-2">Change Password</button>
        </form>
       </div>
    </div>
</body>
